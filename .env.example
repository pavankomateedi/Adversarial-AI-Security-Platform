# Copy to .env and fill in values. NEVER commit .env.

# --- Target System ---
BACKEND_URL=https://your-openemr-copilot.railway.app
BACKEND_API_KEY=
# Co-Pilot uses session-cookie auth (POST /auth/login). Provide test credentials.
BACKEND_USERNAME=
BACKEND_PASSWORD=
# Comma-separated patient_ids the test user is RBAC-assigned to.
BACKEND_TEST_PATIENT_IDS=

# --- LLM Providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://agentforge:agentforge@localhost:5432/agentforge
REDIS_URL=redis://localhost:6379/0

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-64-char-random-hex-string-do-not-use-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
ADMIN_API_KEY=change-me-admin-key

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
PROMETHEUS_PORT=9090

# --- Platform ---
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_CONCURRENT_CAMPAIGNS=3
MAX_TOKENS_PER_CAMPAIGN=500000
COST_ALERT_THRESHOLD_USD=10.00

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# --- CORS (comma-separated origins; * for dev only) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
